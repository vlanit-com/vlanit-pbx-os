#!/bin/sh
# VLANit PBX OS: принудительная активация VG vg0 в initramfs.
# Штатная автоактивация (udev, 69-lvm.rules) активирует VG только когда
# она ПОЛНА — «pvscan checks if this device completes a VG». При умершем
# диске зеркала RAID1 vg0 не «complete» → корень не активируется →
# initramfs shell («/dev/mapper/vg0-root does not exist», стенд mirror,
# фаза degraded). activation_mode по умолчанию «degraded» (trixie),
# поэтому явного 'vgchange -ay' достаточно: полная VG — no-op,
# деградированная — активируется.
#
# На каждом блочном событии: повторная активация активной VG — ~50 мс
# (no-op), поэтому троттлинг не нужен. Он был бы опасен: при
# degraded-загрузке событий всего три (диск + два раздела), и пропуск
# нужного окна означал бы отсутствие активации вообще.

PREREQ=""
prereqs()
{
	echo "$PREREQ"
}

case $1 in
prereqs)
	prereqs
	exit 0
	;;
esac

. /scripts/functions

# На каждом событии: vgchange -ay на уже активной VG — ~50 мс (no-op),
# поэтому троттлинг не нужен. Он был бы опасен: при degraded-загрузке
# событий всего три (диск + два раздела), и пропуск нужного окна означал
# бы отсутствие активации вообще.
/usr/sbin/vgchange -ay vg0 >/dev/null 2>&1 || true
