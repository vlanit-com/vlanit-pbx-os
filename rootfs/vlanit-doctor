#!/usr/bin/env bash
# /usr/local/sbin/vlanit-doctor — сводная диагностика установленной VLANit PBX OS
# (issue #9, спека: docs/specs/1.2.8-vlanit-doctor.md).
#
#   vlanit-doctor              — полный отчёт (OK/FAIL/SKIP по группам)
#   vlanit-doctor --quiet      — только код возврата (0 = всё зелёное)
#   vlanit-doctor --fix-hints  — под каждой проблемой команда-исправление
#   vlanit-doctor --json       — машиночитаемый вывод
#
# Код возврата: 0 — все применимые проверки OK; 1 — есть FAIL.
# Скрипт read-only: ничего не меняет в системе.
set -uo pipefail

# shellcheck source=../lib/checks.sh
CHECKS_LIB="/opt/vlanit/lib/checks.sh"
[ -f "$CHECKS_LIB" ] || { echo "vlanit-doctor: не найден $CHECKS_LIB" >&2; exit 1; }
# shellcheck disable=SC1090
source "$CHECKS_LIB"

QUIET=0 JSON=0 HINTS=0
for a in "$@"; do
    case "$a" in
        --quiet) QUIET=1 ;;
        --json) JSON=1 ;;
        --fix-hints) HINTS=1 ;;
        -h|--help) grep '^#' "$0" | head -12 | cut -c3-; exit 0 ;;
        *) echo "vlanit-doctor: неизвестная опция $a (см. --help)" >&2; exit 2 ;;
    esac
done

F=0 JQ_OUT=""
# шапка plain-отчёта: версия ОС (аудит версий 1.3.2 — в полевых
# логах doctor версию раньше не определить)
if [ "$QUIET" != "1" ] && [ "$JSON" != "1" ]; then
    . /etc/os-release 2>/dev/null && printf 'OS: %s\n' "${PRETTY_NAME:-unknown}"
fi
report() {
    # report <group> <name> <rc>
    local group="$1" name="$2" rc="$3" st
    case "$rc" in
        0) st=OK ;;
        1) st=FAIL; F=1 ;;
        *) st=SKIP ;;
    esac
    [ "$QUIET" = "1" ] && return
    if [ "$JSON" = "1" ]; then
        printf -v JQ_OUT '%s%s' "$JQ_OUT" \
            "$(printf '\n    {"group":"%s","check":"%s","status":"%s"},' "$group" "$name" "$st")"
        return
    fi
    case "$st" in
        OK)   printf '  \033[32mOK\033[0m   %s — %s\n' "$name" "$(desc_"$name")" ;;
        FAIL) printf '  \033[31mFAIL\033[0m %s — %s\n' "$name" "$(desc_"$name")"
              [ "$HINTS" = "1" ] && printf '        └─ исправить: %s\n' "$(hint_"$name")" ;;
        SKIP) printf '  \033[90mSKIP\033[0m %s — %s (не применимо)\n' "$name" "$(desc_"$name")" ;;
    esac
}

for group_def in "${CHECK_GROUPS[@]}"; do
    group="${group_def%%:*}"
    checks="${group_def#*:}"
    [ "$QUIET" = "1" ] || [ "$JSON" = "1" ] || printf '\n\033[1m[%s]\033[0m\n' "$group"
    for name in $checks; do
        "check_$name" >/dev/null 2>&1
        report "$group" "$name" "$?"
    done
done

if [ "$JSON" = "1" ]; then
    printf '{\n  "host": "%s",\n  "result": "%s",\n  "checks": [%s\n  ]\n}\n' \
        "$(hostname)" "$([ $F -eq 0 ] && echo OK || echo FAIL)" "${JQ_OUT%,}"
elif [ "$QUIET" != "1" ]; then
    if [ "$F" -eq 0 ]; then
        printf '\n\033[32mИТОГ: OK\033[0m — все применимые проверки пройдены\n'
    else
        printf '\n\033[31mИТОГ: FAIL\033[0m — см. пункты FAIL выше (--fix-hints для команд исправления)\n'
    fi
fi
exit $F
