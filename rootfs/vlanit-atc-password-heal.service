[Unit]
# Самолечение пароля веб-админа АТС после перезагрузки (issue #10).
# Запускается на КАЖДОЙ загрузке после старта контейнера MikoPBX.
Description=VLANit ATC admin password self-heal (upstream reset workaround)
After=mikopbx.service
Wants=mikopbx.service

[Service]
Type=oneshot
ExecStart=/opt/vlanit/vlanit-atc-password-heal.sh
RemainAfterExit=true
StandardOutput=journal+console
StandardError=journal+console

[Install]
# multi-user.target НЕ должен ждать oneshot-heal (~2,5 мин на медленной
# загрузке, issue #45): подтягиваемся wants-ссылкой от mikopbx.service —
# выполняемся After=mikopbx, но multi-user.target нас не ждёт.
WantedBy=mikopbx.service
