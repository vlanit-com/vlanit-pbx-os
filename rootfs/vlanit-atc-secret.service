[Unit]
# Создание Podman secret с паролем веб-админа АТС ДО старта контейнера
# (issue #34). DefaultDependencies=no + After=local-fs: служба идёт рано и
# НЕ зависит от multi-user.target — цикла порядка загрузки нет.
Description=VLANit ATC admin password (Podman secret)
DefaultDependencies=no
After=local-fs.target
Before=mikopbx.service

[Service]
Type=oneshot
ExecStart=/opt/vlanit/vlanit-atc-secret.sh
RemainAfterExit=true

[Install]
WantedBy=multi-user.target
